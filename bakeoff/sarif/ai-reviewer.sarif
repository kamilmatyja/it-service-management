{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ai-reviewer",
          "informationUri": "https://github.com/swasik/itsm-2026-template",
          "rules": [
            {
              "id": "shell-command-injection",
              "name": "shell-command-injection",
              "shortDescription": {
                "text": "shell-command-injection"
              },
              "properties": {
                "tags": [
                  "CWE-78"
                ]
              }
            },
            {
              "id": "attachment-path-traversal",
              "name": "attachment-path-traversal",
              "shortDescription": {
                "text": "attachment-path-traversal"
              },
              "properties": {
                "tags": [
                  "CWE-22"
                ]
              }
            },
            {
              "id": "sql-like-injection",
              "name": "sql-like-injection",
              "shortDescription": {
                "text": "sql-like-injection"
              },
              "properties": {
                "tags": [
                  "CWE-89"
                ]
              }
            },
            {
              "id": "hardcoded-github-token",
              "name": "hardcoded-github-token",
              "shortDescription": {
                "text": "hardcoded-github-token"
              },
              "properties": {
                "tags": [
                  "CWE-798"
                ]
              }
            },
            {
              "id": "hardcoded-smtp-password",
              "name": "hardcoded-smtp-password",
              "shortDescription": {
                "text": "hardcoded-smtp-password"
              },
              "properties": {
                "tags": [
                  "CWE-798"
                ]
              }
            },
            {
              "id": "hardcoded-search-api-key",
              "name": "hardcoded-search-api-key",
              "shortDescription": {
                "text": "hardcoded-search-api-key"
              },
              "properties": {
                "tags": [
                  "CWE-798"
                ]
              }
            },
            {
              "id": "vulnerable-pyyaml-pin",
              "name": "vulnerable-pyyaml-pin",
              "shortDescription": {
                "text": "vulnerable-pyyaml-pin"
              },
              "properties": {
                "tags": [
                  "CWE-1395"
                ]
              }
            },
            {
              "id": "vulnerable-urllib3-pin",
              "name": "vulnerable-urllib3-pin",
              "shortDescription": {
                "text": "vulnerable-urllib3-pin"
              },
              "properties": {
                "tags": [
                  "CWE-1395"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "shell-command-injection",
          "level": "warning",
          "message": {
            "text": "The ticket identifier is interpolated into a shell command executed with shell=True; pass an argument vector to subprocess.run instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/attachment_export.py"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 11
                }
              }
            }
          ],
          "properties": {
            "class": "injection"
          }
        },
        {
          "ruleId": "attachment-path-traversal",
          "level": "warning",
          "message": {
            "text": "The request-derived filename is joined without a containment check, so traversal components can read files outside the attachment directory."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/attachment_read.py"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 10
                }
              }
            }
          ],
          "properties": {
            "class": "path-traversal"
          }
        },
        {
          "ruleId": "sql-like-injection",
          "level": "warning",
          "message": {
            "text": "The search string is interpolated into SQL; use a bound parameter for the LIKE value."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/app/ticket_search.py"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 10
                }
              }
            }
          ],
          "properties": {
            "class": "injection"
          }
        },
        {
          "ruleId": "hardcoded-github-token",
          "level": "warning",
          "message": {
            "text": "A GitHub API token is hard-coded in application configuration; load credentials from a secret manager or environment."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/github.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "hardcoded-smtp-password",
          "level": "warning",
          "message": {
            "text": "An SMTP password is hard-coded in application configuration; load credentials from a secret manager or environment."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/mailer.py"
                },
                "region": {
                  "startLine": 4,
                  "endLine": 4
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "hardcoded-search-api-key",
          "level": "warning",
          "message": {
            "text": "A search-service API key is hard-coded in application configuration; load credentials from a secret manager or environment."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/config/search.py"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "class": "secret"
          }
        },
        {
          "ruleId": "vulnerable-pyyaml-pin",
          "level": "warning",
          "message": {
            "text": "PyYAML 5.3.1 is an outdated vulnerable dependency; upgrade to a maintained patched release."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/requirements.txt"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "class": "vulnerable-dependency"
          }
        },
        {
          "ruleId": "vulnerable-urllib3-pin",
          "level": "warning",
          "message": {
            "text": "urllib3 1.24.1 is an outdated vulnerable dependency; upgrade to a maintained patched release."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lab5-canary/requirements.txt"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 2
                }
              }
            }
          ],
          "properties": {
            "class": "vulnerable-dependency"
          }
        }
      ],
      "properties": {
        "model": "GitHub Copilot (Auto mode)",
        "route": "local"
      }
    }
  ]
}
